# Committed on purpose: these values are public, they end up in the browser bundle anyway.
# Never put a secret here. To use your own Spotify app, override it in web/.env.local (git-ignored).

# Client ID from https://developer.spotify.com/dashboard (not the client secret: PKCE doesn't need one).
VITE_SPOTIFY_CLIENT_ID=dd79131036984f2a9bed15ced3265646

# For local test runs only: export just the first N playlists. Put it in web/.env.local, not here.
# Unset means all playlists.
# VITE_EXPORT_PLAYLIST_LIMIT=10
