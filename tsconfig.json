// Only for the config files in the root (vitest.config.mts), so ESLint's type-aware rules and
// `npm run check:types` cover them too. The app has its own tsconfigs in web/.
{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["*.mts"]
}
